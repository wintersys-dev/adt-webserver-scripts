Part 3: ConfigureReverseProxy.sh (Section A — Valkey & Upstream Builder)

sh
#!/bin/sh
#################################################################################
# Author : Peter Winter (Unified Reverse Proxy & Regional Valkey Configurator)
# Description : Configures Nginx, Apache, or Lighttpd reverse proxy, regional
#               Valkey object cache, and access gates (ip, basic_auth, wireguard).
#################################################################################
set -eu

export HOME="`/bin/cat /home/homedir.dat`"
PROXY_TYPE="$1" # "nginx", "apache", or "lighttpd"

[ ! -d "${HOME}/logs/configure_proxy_${PROXY_TYPE}" ] && \
    /bin/mkdir -p "${HOME}/logs/configure_proxy_${PROXY_TYPE}"

STAMP="`/bin/date +%Y%m%d_%H%M%S`"
exec 1>>"${HOME}/logs/configure_proxy_${PROXY_TYPE}/out_${STAMP}.log"
exec 2>>"${HOME}/logs/configure_proxy_${PROXY_TYPE}/err_${STAMP}.log"

WEBSITE_NAME="`${HOME}/utilities/config/ExtractConfigValue.sh 'WEBSITEDISPLAYNAME'`"
WEBSITE_URL="`${HOME}/utilities/config/ExtractConfigValue.sh 'WEBSITEURL'`"
ROOT_DOMAIN="`/bin/echo "${WEBSITE_URL}" | /usr/bin/awk -F'.' '{$1=""}1' | /bin/sed 's/^.//' | /bin/sed 's/ /\./g'`"
AUTH_MODE="`${HOME}/utilities/config/ExtractConfigValue.sh 'AUTHMODE' 2>/dev/null || printf 'none'`"
ENABLE_CACHE="`${HOME}/utilities/config/ExtractConfigValue.sh 'ENABLEREGIONALCACHE' 2>/dev/null || printf '1'`"
WG_IP="`/sbin/ip -4 addr show wg0 2>/dev/null | /usr/bin/awk '/inet / {print $2}' | /usr/bin/cut -d/ -f1 || printf '127.0.0.1'`"

# 1. Configure Regional Valkey (or Redis fallback) bound strictly to localhost + wg0
if [ "${ENABLE_CACHE}" = "1" ]; then
    CACHE_PASS_FILE="${HOME}/runtime/valkey_password.dat"
    if [ ! -f "${CACHE_PASS_FILE}" ]; then
        /usr/bin/head -c 24 /dev/urandom | /usr/bin/base64 | /usr/bin/tr -dc 'a-zA-Z0-9' > "${CACHE_PASS_FILE}"
        /bin/chmod 600 "${CACHE_PASS_FILE}"
    fi
    CACHE_PASS="`/bin/cat "${CACHE_PASS_FILE}"`"

    if [ -f /etc/valkey/valkey.conf ]; then
        CACHE_CONF="/etc/valkey/valkey.conf"
        CACHE_SVC="valkey-server"
    else
        CACHE_CONF="/etc/redis/redis.conf"
        CACHE_SVC="redis-server"
    fi

    if [ -f "${CACHE_CONF}" ]; then
        /bin/sed -i '/# --- ADT Regional Cache ---/,$d' "${CACHE_CONF}"
        cat <<EOF >> "${CACHE_CONF}"
# --- ADT Regional Cache ---
bind 127.0.0.1 ${WG_IP}
port 6379
protected-mode yes
requirepass ${CACHE_PASS}
maxmemory 256mb
maxmemory-policy allkeys-lru
save ""
appendonly no
EOF
        ${HOME}/utilities/processing/RunServiceCommand.sh "${CACHE_SVC}" restart
    fi
fi

# 2. Format Upstream Webserver List from ADT runtime IP registry
UPSTREAM_LINES=""
if [ -f "${HOME}/runtime/webserver_ips.dat" ]; then
    while IFS= read -r WS_IP; do
        [ -z "${WS_IP}" ] && continue
        case "${PROXY_TYPE}" in
            nginx)    UPSTREAM_LINES="${UPSTREAM_LINES}    server ${WS_IP}:80 max_fails=3 fail_timeout=10s;\n" ;;
            apache)   UPSTREAM_LINES="${UPSTREAM_LINES}        BalancerMember http://${WS_IP}:80\n" ;;
            lighttpd) UPSTREAM_LINES="${UPSTREAM_LINES}        ( \"host\" => \"${WS_IP}\", \"port\" => 80 ),\n" ;;
        esac
    done < "${HOME}/runtime/webserver_ips.dat"
fi
[ -z "${UPSTREAM_LINES}" ] && UPSTREAM_LINES="    # No upstreams registered yet"
Use code with caution.

Part 4: ConfigureReverseProxy.sh (Section B — Gates, Templates & Fallback)

Append this directly below Section A in ConfigureReverseProxy.sh:
sh
# 3. Map Proxy Paths, Enable Modules & Initialize Access Gate Files
case "${PROXY_TYPE}" in
    nginx)
        AVAIL_DIR="/etc/nginx/sites-available"
        ENAB_DIR="/etc/nginx/sites-enabled"
        SITE_FILE="${AVAIL_DIR}/${WEBSITE_NAME}"
        LINK_FILE="${ENAB_DIR}/${WEBSITE_NAME}"
        IP_GATE_FILE="/etc/nginx/snippets/adt-allowed-ips.conf"
        HTPASSWD_FILE="/etc/nginx/.htpasswd"
        TEST_CMD="/usr/sbin/nginx -t"
        SVC_NAME="nginx"
        /bin/mkdir -p /dev/shm/nginx-proxy-cache /etc/nginx/snippets
        /bin/chown -R www-data:www-data /dev/shm/nginx-proxy-cache
        ;;
    apache)
        AVAIL_DIR="/etc/apache2/sites-available"
        ENAB_DIR="/etc/apache2/sites-enabled"
        SITE_FILE="${AVAIL_DIR}/${WEBSITE_NAME}.conf"
        LINK_FILE="${ENAB_DIR}/${WEBSITE_NAME}.conf"
        IP_GATE_FILE="/etc/apache2/conf-available/adt-allowed-ips.conf"
        HTPASSWD_FILE="/etc/apache2/.htpasswd"
        TEST_CMD="/usr/sbin/apache2ctl -t"
        SVC_NAME="apache2"
        /bin/mkdir -p /dev/shm/apache-proxy-cache
        /bin/chown -R www-data:www-data /dev/shm/apache-proxy-cache
        /usr/sbin/a2enmod -q proxy proxy_http proxy_balancer lbmethod_byrequests cache cache_disk headers rewrite ssl authn_file authz_user
        ;;
    lighttpd)
        AVAIL_DIR="/etc/lighttpd/conf-available"
        ENAB_DIR="/etc/lighttpd/conf-enabled"
        SITE_FILE="${AVAIL_DIR}/99-${WEBSITE_NAME}.conf"
        LINK_FILE="${ENAB_DIR}/99-${WEBSITE_NAME}.conf"
        IP_GATE_FILE="/etc/lighttpd/conf-available/85-adt-allowed-ips.conf"
        HTPASSWD_FILE="/etc/lighttpd/.htpasswd"
        TEST_CMD="/usr/sbin/lighttpd -tt -f /etc/lighttpd/lighttpd.conf"
        SVC_NAME="lighttpd"
        /usr/sbin/lighttpd-enable-mod proxy auth 2>/dev/null || true
        ;;
    *)
        /bin/echo "ERROR: Unsupported proxy type '${PROXY_TYPE}'" >&2
        exit 1
        ;;
esac

[ ! -f "${IP_GATE_FILE}" ] && : > "${IP_GATE_FILE}"
[ ! -f "${HTPASSWD_FILE}" ] && : > "${HTPASSWD_FILE}"
/bin/chmod 640 "${IP_GATE_FILE}" "${HTPASSWD_FILE}"
/bin/chown root:www-data "${IP_GATE_FILE}" "${HTPASSWD_FILE}"

USER_REPO_DIR="${USER_CONFIG_REPO:-/nonexistent}/reverseproxy/${PROXY_TYPE}"
ADT_BASE_DIR="${HOME}/reverseproxy/configuration/${PROXY_TYPE}"
WORK_SITE="/tmp/adt-proxy.$$"
trap 'rm -f "${WORK_SITE}"' EXIT

/bin/mkdir -p "${AVAIL_DIR}" "${ENAB_DIR}"
/bin/rm -f "${AVAIL_DIR}"/* "${ENAB_DIR}"/*

if [ -f "${USER_REPO_DIR}/proxy.conf" ]; then
    /bin/cp "${USER_REPO_DIR}/proxy.conf" "${WORK_SITE}"
    CUSTOM_USED=1
else
    /bin/cp "${ADT_BASE_DIR}/proxy.conf.DEFAULT" "${WORK_SITE}"
    CUSTOM_USED=0
fi

apply_proxy_substitutions() {
    TARGET="$1"
    /bin/sed -i "s|XXXXWEBSITEURLXXXX|${WEBSITE_URL}|g" "${TARGET}"
    /bin/sed -i "s|XXXXROOTDOMAINXXXX|${ROOT_DOMAIN}|g" "${TARGET}"

    # Inject multi-line upstream server list safely via awk
    /usr/bin/awk -v upstreams="${UPSTREAM_LINES}" '{
        gsub(/XXXXUPSTREAMSERVERSXXXX/, upstreams);
        print;
    }' "${TARGET}" > "${TARGET}.tmp" && /bin/mv "${TARGET}.tmp" "${TARGET}"

    [ -f "/etc/letsencrypt/live/${WEBSITE_URL}/fullchain.pem" ] && \
        /bin/sed -i "s/#XXXXHTTPSXXXX//g" "${TARGET}"

    case "${AUTH_MODE}" in
        ip)         /bin/sed -i "s/#XXXXAUTHIPXXXX//g" "${TARGET}" ;;
        basic_auth) /bin/sed -i "s/#XXXXAUTHBASICXXXX//g" "${TARGET}" ;;
        wireguard)  /bin/sed -i "s/#XXXXWIREGUARDXXXX//g" "${TARGET}" ;;
    esac

    /bin/sed -i '/#XXXX.*/d' "${TARGET}"
}

apply_proxy_substitutions "${WORK_SITE}"
/bin/cp "${WORK_SITE}" "${SITE_FILE}"
/bin/chmod 600 "${SITE_FILE}"
/bin/ln -sf "${SITE_FILE}" "${LINK_FILE}"

if ! ${TEST_CMD} >/dev/null 2>&1; then
    if [ "${CUSTOM_USED}" -eq 1 ]; then
        ${HOME}/services/email/SendEmail.sh \
            "CUSTOM ${SVC_NAME} PROXY CONFIG FAILED" \
            "Custom ${SVC_NAME} proxy.conf in user repo failed syntax test; reverting to ADT default." \
            "ERROR"
        /bin/cp "${ADT_BASE_DIR}/proxy.conf.DEFAULT" "${SITE_FILE}"
        apply_proxy_substitutions "${SITE_FILE}"
    else
        /bin/echo "CRITICAL: Default ${SVC_NAME} proxy configuration failed syntax check." >&2
        exit 1
    fi
fi

/bin/echo "${SITE_FILE}" > "${HOME}/runtime/PROXY_CONFIG_LOCATION.dat"
${HOME}/utilities/processing/RunServiceCommand.sh "${SVC_NAME}" restart
Use code with caution.
