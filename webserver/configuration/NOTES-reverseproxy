Part 2: Default Reverse Proxy Templates (proxy.conf.DEFAULT)

Each template includes edge microcaching (bypasses logged-in CMS cookies automatically), upstream webserver load-balancing (XXXXUPSTREAMSERVERSXXXX), and toggleable #XXXXAUTHIPXXXX / #XXXXAUTHBASICXXXX / #XXXXWIREGUARDXXXX gates.

A. nginx/proxy.conf.DEFAULT

nginx
proxy_cache_path /dev/shm/nginx-proxy-cache levels=1:2 keys_zone=ADT_EDGE:32m max_size=256m inactive=10m use_temp_path=off;

upstream adt_webservers {
    least_conn;
    XXXXUPSTREAMSERVERSXXXX
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    #XXXXHTTPSXXXXlisten 443 ssl http2;
    #XXXXHTTPSXXXXlisten [::]:443 ssl http2;

    server_name XXXXWEBSITEURLXXXX XXXXROOTDOMAINXXXX;
    server_tokens off;

    #XXXXHTTPSXXXXssl_certificate /etc/letsencrypt/live/XXXXWEBSITEURLXXXX/fullchain.pem;
    #XXXXHTTPSXXXXssl_certificate_key /etc/letsencrypt/live/XXXXWEBSITEURLXXXX/privkey.pem;
    #XXXXHTTPSXXXXssl_dhparam /etc/ssl/certs/dhparam.pem;
    #XXXXHTTPSXXXXssl_protocols TLSv1.2 TLSv1.3;

    # Access Control Gates (toggled by ADT AUTH_MODE)
    #XXXXAUTHIPXXXXinclude /etc/nginx/snippets/adt-allowed-ips.conf;
    #XXXXAUTHBASICXXXXauth_basic "Wintersys Protected Gateway";
    #XXXXAUTHBASICXXXXauth_basic_user_file /etc/nginx/.htpasswd;

    # Bypass edge cache for logged-in CMS sessions & POST requests
    set $skip_cache 0;
    if ($request_method = POST) { set $skip_cache 1; }
    if ($query_string != "") { set $skip_cache 1; }
    if ($http_cookie ~* "wordpress_logged_in_|wp-postpass_|joomla_|SESS[a-z0-9]+|MoodleSession") {
        set $skip_cache 1;
    }

    location / {
        proxy_pass http://adt_webservers;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Edge Microcaching (30s anonymous cache + stale fallback if WAN DB hiccups)
        proxy_cache ADT_EDGE;
        proxy_cache_bypass $skip_cache;
        proxy_no_cache $skip_cache;
        proxy_cache_valid 200 301 302 30s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-ADT-Cache $upstream_cache_status;
    }
}
