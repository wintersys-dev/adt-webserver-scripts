<?php
$rawEmail = trim($_POST["email"] ?? "");
$email    = filter_var($rawEmail, FILTER_VALIDATE_EMAIL);

if ($email === false) {
    http_response_code(400);
    $statusBadge = "Invalid Request";
    $badgeClass  = "badge-error";
    $heading     = "Invalid Email Address";
    $messageHtml = "Please go back and enter a valid, authorized email address.";
    $subNoteHtml = "No verification email has been queued.";
} else {
    $file = "/var/www/whitelist/authentication-emails.dat";
    $data = $email . "\n";
    file_put_contents($file, $data, FILE_APPEND | LOCK_EX);

    $safeEmail   = htmlspecialchars($email, ENT_QUOTES, "UTF-8");
    $statusBadge = "Verification Queued";
    $badgeClass  = "badge-success";
    $heading     = "Email Address Submitted";
    $messageHtml = "If needed, you should shortly receive an authentication email at <strong>{$safeEmail}</strong>.";
    $subNoteHtml = "The link in the email will be valid for <strong>30 minutes</strong>.";
}
?>
