<?php
declare(strict_types=1);

// Ensure POST-only execution
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
    http_response_code(405);
    exit('Method Not Allowed');
}

$allowedDomain = strtolower(trim('XXXXUSEREMAILDOMAINXXXX'));
$rawEmail      = trim($_POST['email'] ?? '');
$email         = filter_var($rawEmail, FILTER_VALIDATE_EMAIL);

$statusBadge = 'Invalid Request';
$badgeClass  = 'badge-error';
$heading     = 'Submission Rejected';
$messageHtml = 'Please go back and enter a valid, authorized email address.';
$subNoteHtml = 'No verification email has been queued.';

if ($email === false) {
    http_response_code(400);
} else {
    $email       = strtolower($email);
    $emailDomain = substr(strrchr($email, '@') ?: '', 1);

    // Server-side domain enforcement (prevents curl/API bypasses of HTML pattern)
    if ($allowedDomain !== '' && $emailDomain !== $allowedDomain) {
        http_response_code(403);
        $safeDomain  = htmlspecialchars($allowedDomain, ENT_QUOTES, 'UTF-8');
        $messageHtml = "Access is strictly restricted to <strong>@{$safeDomain}</strong> email addresses.";
    } else {
        $whitelistDir = '/var/www/whitelist';
        $tokenDir     = $whitelistDir . '/tokens';
        $emailFile    = $whitelistDir . '/authentication-emails.dat';

        if (!is_dir($tokenDir)) {
            @mkdir($tokenDir, 0750, true);
        }

        // Rate-limit / deduplicate pending requests for the same email
        $alreadyQueued = false;
        if (is_file($emailFile)) {
            $lines = file($emailFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [];
            foreach ($lines as $line) {
                $existingEmail = strtolower(trim(explode('|', $line)[0]));
                if ($existingEmail === $email) {
                    $alreadyQueued = true;
                    break;
                }
            }
        }

        if (!$alreadyQueued) {
            // Generate a cryptographic 64-char one-time token (valid for 30 minutes)
            $token     = bin2hex(random_bytes(32));
            $tokenFile = $tokenDir . '/' . $token . '.json';

            file_put_contents($tokenFile, json_encode([
                'email'   => $email,
                'created' => time(),
            ]), LOCK_EX);
            @chmod($tokenFile, 0640);

            // NOTE: If your ADT cron script expects ONLY "$email\n", change the line below to:
            // $data = $email . "\n";
            $data = $email . '|' . $token . "\n";
            file_put_contents($emailFile, $data, FILE_APPEND | LOCK_EX);
        }

        $safeEmail   = htmlspecialchars($email, ENT_QUOTES, 'UTF-8');
        $statusBadge = 'Verification Queued';
        $badgeClass  = 'badge-success';
        $heading     = 'Email Address Submitted';
        $messageHtml = "If authorized, you should shortly receive an authentication email at <strong>{$safeEmail}</strong>.";
        $subNoteHtml = 'The link in the email will be valid for <strong>30 minutes</strong>.';
    }
}
?>
<!DOCTYPE html>
