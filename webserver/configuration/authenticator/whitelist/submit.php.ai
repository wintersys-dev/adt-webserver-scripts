            letter-spacing: -0.01em;
        }

        .message {
            color: var(--text-muted);
            font-size: 0.94rem;
            line-height: 1.6;
            margin-bottom: 1.25rem;
        }

        .message strong {
            color: var(--text-main);
            font-weight: 600;
        }

        .info-box {
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #93c5fd;
            border-radius: 8px;
            padding: 0.85rem 1rem;
            font-size: 0.86rem;
            line-height: 1.5;
        }

        .info-box strong {
            color: #dbeafe;
        }

        .footer-note {
            margin-top: 1.5rem;
            padding-top: 1.1rem;
            border-top: 1px solid var(--border-color);
            font-size: 0.78rem;
            color: var(--text-muted);
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="main">
        <div class="badge <?= $badgeClass ?>"><span class="dot"></span> <?= htmlspecialchars($statusBadge, ENT_QUOTES, 'UTF-8') ?></div>

        <h1><?= htmlspecialchars($heading, ENT_QUOTES, 'UTF-8') ?></h1>
        <p class="message"><?= $messageHtml ?></p>

        <div class="info-box">
            <?= $subNoteHtml ?>
        </div>

        <div class="footer-note">
            Protected by Wintersys Agile Deployment Toolkit
        </div>
    </div>
</body>

</html>

