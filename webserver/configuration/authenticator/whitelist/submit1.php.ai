<?php
declare(strict_types=1);

// Ensure POST-only execution
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
    http_response_code(405);
    exit('Method Not Allowed');
}

$tokenDir        = '/var/www/whitelist/tokens';
$ipFile          = '/var/www/whitelist/ipaddresses.dat';
$tokenTtlSeconds = 1800; // 30 minutes

$token     = trim($_POST['token'] ?? '');
$rawIp     = trim($_POST['ipaddress'] ?? '');
$ipaddress = filter_var(
    $rawIp,
    FILTER_VALIDATE_IP,
    FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE
);

$statusBadge = 'Access Denied';
$badgeClass  = 'badge-error';
$heading     = 'Authorization Failed';
$messageHtml = 'Your verification link is invalid or has expired.';
$subNoteHtml = 'Please return to the login portal and request a new verification email.';

// 1. Validate one-time cryptographic token format and existence
if ($token !== '' && preg_match('/^[a-f0-9]{64}$/', $token)) {
    $tokenFile = $tokenDir . '/' . $token . '.json';

    if (is_file($tokenFile)) {
        $tokenData = json_decode((string)file_get_contents($tokenFile), true);
        $created   = is_array($tokenData) ? (int)($tokenData['created'] ?? 0) : 0;

        if ($created > 0 && (time() - $created) <= $tokenTtlSeconds) {
            // 2. Validate that the submitted IP is a routable public IPv4 or IPv6 address
            if ($ipaddress === false) {
                http_response_code(400);
                $heading     = 'Invalid Public IP Address';
                $messageHtml = 'Please go back and enter a valid public IPv4 or IPv6 address (private/local IPs are not permitted).';
                $subNoteHtml = 'Your verification token remains active—go back and try again.';
            } else {
                // 3. Write IP atomically and consume the token immediately so it cannot be replayed
                $data = $ipaddress . "\n";
                if (file_put_contents($ipFile, $data, FILE_APPEND | LOCK_EX) !== false) {
                    @unlink($tokenFile);

                    $safeIp      = htmlspecialchars($ipaddress, ENT_QUOTES, 'UTF-8');
                    $statusBadge = 'Access Requested';
                    $badgeClass  = 'badge-success';
                    $heading     = 'IP Address Submitted';
                    $messageHtml = "Access for your IP address (<strong>{$safeIp}</strong>) has been requested.";
                    $subNoteHtml = 'It might take <strong>up to a minute</strong> to take effect. Any longer and there is a problem.';
                } else {
                    http_response_code(500);
                    $heading     = 'System Queue Error';
                    $messageHtml = 'Unable to write your IP address to the firewall authorization queue.';
                    $subNoteHtml = 'Please contact your system administrator.';
                }
            }
        } else {
            // Expired token: clean up and reject
            @unlink($tokenFile);
            http_response_code(403);
            $heading     = 'Verification Link Expired';
            $messageHtml = 'This verification link exceeded its 30-minute validity window.';
        }
    } else {
        http_response_code(403);
    }
} else {
    http_response_code(403);
}
?>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IP Address Access Requested</title>
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-card: #1e293b;
            --border-color: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: radial-gradient(circle at top, #1e293b 0%, var(--bg-primary) 70%);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .main {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            width: 100%;
            max-width: 460px;
            padding: 2.25rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            padding: 0.3rem 0.7rem;
            border-radius: 999px;
            margin-bottom: 1.25rem;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .badge-success .dot {
            background: #34d399;
        }

        .badge-error {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        .badge-error .dot {
            background: #f87171;
        }

        .badge .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        h1 {
            font-size: 1.4rem;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 0.75rem;
            letter-spacing: -0.01em;
        }

        .message {
            color: var(--text-muted);
            font-size: 0.94rem;
            line-height: 1.6;
            margin-bottom: 1.25rem;
        }

        .message strong {
            color: var(--text-main);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-weight: 600;
        }

        .info-box {
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            color: #93c5fd;
            border-radius: 8px;
            padding: 0.85rem 1rem;
            font-size: 0.86rem;
            line-height: 1.5;
        }

        .info-box strong {
            color: #dbeafe;
        }

        .footer-note {
            margin-top: 1.5rem;
            padding-top: 1.1rem;
            border-top: 1px solid var(--border-color);
            font-size: 0.78rem;
            color: var(--text-muted);
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="main">
        <div class="badge <?= $badgeClass ?>"><span class="dot"></span> <?= htmlspecialchars($statusBadge, ENT_QUOTES, 'UTF-8') ?></div>

        <h1><?= htmlspecialchars($heading, ENT_QUOTES, 'UTF-8') ?></h1>
        <p class="message"><?= $messageHtml ?></p>

        <div class="info-box">
            <?= $subNoteHtml ?>
        </div>

        <div class="footer-note">
            Protected by Wintersys Agile Deployment Toolkit
        </div>
    </div>
</body>

</html>
