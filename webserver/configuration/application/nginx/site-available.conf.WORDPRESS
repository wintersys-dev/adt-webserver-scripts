
map $http_user_agent $blockedagent {
 default         0;
 ~*malicious     1;
 ~*bot           1;
 ~*backdoor      1;
 ~*crawler       1;
 ~*bandit        1;
 ~*Amazonbot 	 1;
 ~*openai 		 1;
 ~*chatgpt 		 1;
 ~*gptbot 		 1;
}

#XXXXPHPPORTXXXXupstream php {
#XXXXPHPPORTXXXX    server 127.0.0.1:XXXXPORTXXXX;
#XXXXPHPPORTXXXX    keepalive_timeout 65;
#XXXXPHPPORTXXXX}

server 
{
    listen    80;
  #  listen   [::]:80 ssl;
    http2 on;
    server_name XXXXWEBSITEURLXXXX;
    return 301 https://$host$request_uri;
}

server
{
    if ($blockedagent)
    {
        return 403;
    }

    listen    443 ssl;
  #  listen    [::]:443 ssl;
    http2 on;
    server_name XXXXWEBSITEURLXXXX;
    root XXXXWEBROOT_DIRECTORYXXXX;
    index index.php index.html;
    
    ssl_certificate XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/fullchain.pem;
    ssl_certificate_key XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/privkey.pem;
    ssl_trusted_certificate XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/fullchain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
	ssl_dhparam /etc/ssl/certs/dhparam.pem;


	# security headers
	add_header X-Frame-Options SAMEORIGIN;
	add_header X-XSS-Protection          "1; mode=block" always;
	add_header X-Content-Type-Options    "nosniff" always;
	add_header Referrer-Policy           "no-referrer-when-downgrade" always;
	add_header Permissions-Policy        "interest-cohort=()" always;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

#XXXXMODSECURITYXXXXmodsecurity on;
#XXXXMODSECURITYXXXXmodsecurity_rules_file /etc/nginx/modsec/main.conf;

    # Block access to dotfiles (like .git, .env) and vendor paths
    location ~ /\.(?!well-known) 
    {
        deny all;
    }

	# Core WordPress routing & Permalinks
	location / 
	{
		try_files $uri $uri/ /index.php?$args;
	}

	# Cache static assets aggressively 
	location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf|webp|avif)$ 
	{
		expires max;
		log_not_found off;
		access_log off;
		add_header Cache-Control "public, must-revalidate, proxy-revalidate";
	}

	location ~* /(?:uploads|files|wp-content|wp-includes)/.*\.php$ 
	{
		deny all;
	}
	
	# Disable logging for favicon and robots.txt
	location = /favicon.ico { log_not_found off; access_log off; }
	location = /robots.txt  { log_not_found off; access_log off; allow all; }

#XXXXPHPPORTXXXX	location ~ \.php$ 
#XXXXPHPPORTXXXX	{
#XXXXPHPPORTXXXX		try_files $uri =404;
#XXXXPHPPORTXXXX		include /etc/nginx/fastcgi_params;       
#XXXXPHPPORTXXXX		fastcgi_index index.php;
#XXXXPHPPORTXXXX		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
#XXXXPHPPORTXXXX		fastcgi_intercept_errors on;
#XXXXPHPPORTXXXX		# Mitigate micro-timeout issues
#XXXXPHPPORTXXXX		fastcgi_connect_timeout 60;
#XXXXPHPPORTXXXX		fastcgi_send_timeout 180;
#XXXXPHPPORTXXXX		fastcgi_read_timeout 180;
#XXXXPHPPORTXXXX		fastcgi_buffer_size 256k;
#XXXXPHPPORTXXXX		fastcgi_buffers 4 256k;
#XXXXPHPPORTXXXX		fastcgi_busy_buffers_size 256k;
#XXXXPHPPORTXXXX		fastcgi_temp_file_write_size 256k;
#XXXXPHPPORTXXXX		fastcgi_pass php;
#XXXXPHPPORTXXXX	}

#XXXXPHPSOCKETXXXX	location ~ \.php$ 
#XXXXPHPSOCKETXXXX	{
#XXXXPHPSOCKETXXXX		try_files $uri =404;
#XXXXPHPSOCKETXXXX		include /etc/nginx/fastcgi_params;     
#XXXXPHPSOCKETXXXX		fastcgi_index index.php;
#XXXXPHPSOCKETXXXX		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;  
#XXXXPHPSOCKETXXXX		# Mitigate micro-timeout issues
#XXXXPHPSOCKETXXXX		fastcgi_connect_timeout 60;
#XXXXPHPSOCKETXXXX		fastcgi_send_timeout 180;
#XXXXPHPSOCKETXXXX		fastcgi_read_timeout 180;
#XXXXPHPSOCKETXXXX		fastcgi_buffer_size 256k;
#XXXXPHPSOCKETXXXX		fastcgi_buffers 4 256k;
#XXXXPHPSOCKETXXXX		fastcgi_busy_buffers_size 256k;
#XXXXPHPSOCKETXXXX		fastcgi_temp_file_write_size 256k;
#XXXXPHPSOCKETXXXX      fastcgi_pass unix:/var/run/phpXXXXPHPVERSIONXXXX-fpm.sock;
#XXXXPHPSOCKETXXXX	}

}
