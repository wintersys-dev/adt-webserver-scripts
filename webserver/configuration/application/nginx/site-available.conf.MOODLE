
map $http_user_agent $blockedagent {
 default         0;
 ~*malicious     1;
 ~*bot           1;
 ~*backdoor      1;
 ~*crawler       1;
 ~*bandit        1;
 ~*Amazonbot 	 1;
 ~*openai 		 1;
 ~*chatgpt 		 1;
 ~*gptbot 		 1;
}

#XXXXPHPPORTXXXXupstream php {
#XXXXPHPPORTXXXX    server 127.0.0.1:XXXXPORTXXXX;
#XXXXPHPPORTXXXX    keepalive_timeout 65;
#XXXXPHPPORTXXXX}

server {
    listen    80;
  #  listen   [::]:80 ssl;
    http2 on;
    server_name XXXXWEBSITEURLXXXX;
    return 301 https://$host$request_uri;
}

server
{
    if ($blockedagent)
    {
        return 403;
    }

    listen    443 ssl;
  #  listen    [::]:443 ssl;
    http2 on;
    server_name XXXXWEBSITEURLXXXX;
    root XXXXWEBROOT_DIRECTORYXXXX/XXXXWEBROOT_SUBDIRECTORYXXXX;
    index index.php index.html;
    
    ssl_certificate XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/fullchain.pem;
    ssl_certificate_key XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/privkey.pem;
    ssl_trusted_certificate XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/fullchain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
	ssl_dhparam /etc/ssl/certs/dhparam.pem;

	# security headers
	add_header X-Frame-Options SAMEORIGIN;
	add_header X-XSS-Protection          "1; mode=block" always;
	add_header X-Content-Type-Options    "nosniff" always;
	add_header Referrer-Policy           "no-referrer-when-downgrade" always;
	add_header Permissions-Policy        "interest-cohort=()" always;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

#XXXXMODSECURITYXXXXmodsecurity on;
#XXXXMODSECURITYXXXXmodsecurity_rules_file /etc/nginx/modsec/main.conf;

	client_max_body_size 100M; # Increase for large file uploads/course backups

	location / 
	{
		try_files $uri $uri/ /r.php$is_args$args;
	}

	location /dataroot/
	{
		internal;
		alias /var/www/html/moodle/moodledata/;
	}

	# Hide all dot files but allow "Well-Known URIs" as per RFC 5785 
    location ~ /\.(?!well-known).* 
	{
		return 404;
	} 

#XXXXPHPPORTXXXX	location ~ \.php(/|$) 
#XXXXPHPPORTXXXX	{
#XXXXPHPPORTXXXX		# Split the path info based on URI.
#XXXXPHPPORTXXXX		fastcgi_split_path_info ^(.+\.php)(/.*)$;
#XXXXPHPPORTXXXX
#XXXXPHPPORTXXXX		# Note: Store the original path_info. It will be wiped out in a moment by try_files.
#XXXXPHPPORTXXXX		set $path_info $fastcgi_path_info;
#XXXXPHPPORTXXXX
#XXXXPHPPORTXXXX		# Look for the php file, trying a trailing slash for directories if required. 
#XXXXPHPPORTXXXX		# Finally, send the request to the router - r.php - as a fallback.
#XXXXPHPPORTXXXX		try_files $fastcgi_script_name $fastcgi_script_name/ /r.php$is_args$args;
#XXXXPHPPORTXXXX
#XXXXPHPPORTXXXX		# File was found - pass to fastcgi.
#XXXXPHPPORTXXXX		fastcgi_pass php;       
#XXXXPHPPORTXXXX		# Alternately, pass to unix socket (depends on pool listen configuration)
#XXXXPHPPORTXXXX		# fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
#XXXXPHPPORTXXXX
#XXXXPHPPORTXXXX		include /etc/nginx/fastcgi_params;
#XXXXPHPPORTXXXX
#XXXXPHPPORTXXXX		# Re-apply the path_info after including fastcgi_params.
#XXXXPHPPORTXXXX		fastcgi_param PATH_INFO $path_info;
#XXXXPHPPORTXXXX		fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
#XXXXPHPPORTXXXX		fastcgi_param DOCUMENT_ROOT $realpath_root;
#XXXXPHPPORTXXXX	}


#XXXXPHPSOCKETXXXX	location ~ \.php(/|$) 
#XXXXPHPSOCKETXXXX	{
#XXXXPHPSOCKETXXXX		# Split the path info based on URI.
#XXXXPHPSOCKETXXXX		fastcgi_split_path_info ^(.+\.php)(/.*)$;
#XXXXPHPSOCKETXXXX
#XXXXPHPSOCKETXXXX		# Note: Store the original path_info. It will be wiped out in a moment by try_files.
#XXXXPHPSOCKETXXXX		set $path_info $fastcgi_path_info;
#XXXXPHPSOCKETXXXX
#XXXXPHPSOCKETXXXX		# Look for the php file, trying a trailing slash for directories if required. 
#XXXXPHPSOCKETXXXX		# Finally, send the request to the router - r.php - as a fallback.
#XXXXPHPSOCKETXXXX		try_files $fastcgi_script_name $fastcgi_script_name/ /r.php$is_args$args;
#XXXXPHPSOCKETXXXX
#XXXXPHPSOCKETXXXX		# File was found - pass to fastcgi.
#XXXXPHPSOCKETXXXX		fastcgi_pass unix:/var/run/phpXXXXPHPVERSIONXXXX-fpm.sock;      
#XXXXPHPSOCKETXXXX		# Alternately, pass to unix socket (depends on pool listen configuration)
#XXXXPHPSOCKETXXXX		# fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
#XXXXPHPSOCKETXXXX
#XXXXPHPSOCKETXXXX		include /etc/nginx/fastcgi_params;
#XXXXPHPSOCKETXXXX
#XXXXPHPSOCKETXXXX		# Re-apply the path_info after including fastcgi_params.
#XXXXPHPSOCKETXXXX		fastcgi_param PATH_INFO $path_info;
#XXXXPHPSOCKETXXXX		fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
#XXXXPHPSOCKETXXXX		fastcgi_param DOCUMENT_ROOT $realpath_root;
#XXXXPHPSOCKETXXXX}

	location ~ (/vendor/|/node_modules/|composer\.json|/readme|/README|readme\.txt|/upgrade\.txt|/UPGRADING\.md|db/install\.xml|/fixtures/|/behat/|phpunit\.xml|\.lock|environment\.xml) 
	{ 
		deny all;
		return 404; 
	}
}


