
map $http_user_agent $blockedagent {
 default         0;
 ~*malicious     1;
 ~*bot           1;
 ~*backdoor      1;
 ~*crawler       1;
 ~*bandit        1;
 ~*Amazonbot 	 1;
 ~*openai 		 1;
 ~*chatgpt 		 1;
 ~*gptbot 		 1;
}

#XXXXPHPPORTXXXXupstream php {
#XXXXPHPPORTXXXX    server 127.0.0.1:XXXXPORTXXXX;
#XXXXPHPPORTXXXX    keepalive_timeout 65;
#XXXXPHPPORTXXXX}

server {
    listen    80;
  #  listen   [::]:80 ssl;
    http2 on;
    server_name XXXXWEBSITEURLXXXX;
    return 301 https://$host$request_uri;
}

server
{
    if ($blockedagent)
    {
        return 403;
    }

    listen    443 ssl;
  #  listen    [::]:443 ssl;
    http2 on;
    server_name XXXXWEBSITEURLXXXX;
    root XXXXWEBROOT_DIRECTORYXXXX/XXXXWEBROOT_SUBDIRECTORYXXXX;
    index index.php index.html;
    
    ssl_certificate XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/fullchain.pem;
    ssl_certificate_key XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/privkey.pem;
    ssl_trusted_certificate XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/fullchain.pem;

	# security headers
	add_header X-Frame-Options SAMEORIGIN;
	add_header X-XSS-Protection          "1; mode=block" always;
	add_header X-Content-Type-Options    "nosniff" always;
	add_header Referrer-Policy           "no-referrer-when-downgrade" always;
	add_header Permissions-Policy        "interest-cohort=()" always;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	ssl_dhparam /etc/ssl/certs/dhparam.pem;

#XXXXMODSECURITYXXXXmodsecurity on;
#XXXXMODSECURITYXXXXmodsecurity_rules_file /etc/nginx/modsec/main.conf;
        
	client_max_body_size 100M; # Increase for large file uploads/course backups

	# Moodle Routing Engine
	location /
	{
		try_files $uri $uri/ /r.php;
	}

	# Internal X-Accel-Redirect mapping for secure file serving via dataroot
	location /dataroot/
	{
		internal;
		alias /var/www/html/moodle/moodledata/;
	}

	# Static assets caching
	location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg|eot|mp4|webm)$
	{
		expires max;
		log_not_found off;
	}

	# Deny access to hidden files
	location ~ /\.
	{
		deny all;
	}


# Pass PHP scripts to FastCGI (PHP-FPM)

#XXXXPHPPORTXXXX	location ~ \.php(/|$)
#XXXXPHPPORTXXXX	{
#XXXXPHPPORTXXXX		include fastcgi_params;
#XXXXPHPPORTXXXX		fastcgi_split_path_info ^(.+\.php)(/.+)$;
#XXXXPHPPORTXXXX		fastcgi_pass php;
#XXXXPHPPORTXXXX		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
#XXXXPHPPORTXXXX		fastcgi_param PATH_INFO $fastcgi_path_info;
#XXXXPHPPORTXXXX		fastcgi_index index.php;
#XXXXPHPPORTXXXX		fastcgi_read_timeout 300;
#XXXXPHPPORTXXXX	}

#XXXXPHPSOCKETXXXX	location ~ \.php(/|$)
#XXXXPHPSOCKETXXXX	{
#XXXXPHPSOCKETXXXX		include fastcgi_params;
#XXXXPHPSOCKETXXXX		fastcgi_split_path_info ^(.+\.php)(/.+)$;
