
map $http_user_agent $blockedagent {
 default         0;
 ~*malicious     1;
 ~*bot           1;
 ~*backdoor      1;
 ~*crawler       1;
 ~*bandit        1;
 ~*Amazonbot 	 1;
 ~*openai 		 1;
 ~*chatgpt 		 1;
 ~*gptbot 		 1;
}

#XXXXPHPPORTXXXXupstream php {
#XXXXPHPPORTXXXX    server 127.0.0.1:XXXXPORTXXXX;
#XXXXPHPPORTXXXX    keepalive_timeout 65;
#XXXXPHPPORTXXXX}

server {
    listen    80;
  #  listen   [::]:80 ssl;
    http2 on;
    server_name XXXXWEBSITEURLXXXX;
    return 301 https://$host$request_uri;
}

server
{
    if ($blockedagent)
    {
        return 403;
    }

    listen    443 ssl;
  #  listen    [::]:443 ssl;
    http2 on;
    server_name XXXXWEBSITEURLXXXX;
    root XXXXWEBROOT_DIRECTORYXXXX;
    index index.php index.html;
    
    ssl_certificate XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/fullchain.pem;
    ssl_certificate_key XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/privkey.pem;
    ssl_trusted_certificate XXXXHOMEXXXX/ssl/live/XXXXWEBSITEURLXXXX/fullchain.pem;

	# security headers
	add_header X-Frame-Options SAMEORIGIN;
	add_header X-XSS-Protection          "1; mode=block" always;
	add_header X-Content-Type-Options    "nosniff" always;
	add_header Referrer-Policy           "no-referrer-when-downgrade" always;
	add_header Permissions-Policy        "interest-cohort=()" always;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	ssl_dhparam /etc/ssl/certs/dhparam.pem;

#XXXXMODSECURITYXXXXmodsecurity on;
#XXXXMODSECURITYXXXXmodsecurity_rules_file /etc/nginx/modsec/main.conf;
    
    charset utf-8;

    # Maximum file upload size (Adjust based on user photo/video needs)
    client_max_body_size 64M; 

    # Pretty URL rewrites for OSSN
    location / {
        try_files $uri $uri/ /index.php?handler=$request_uri&$query_string;
    }

    # Security: Deny direct access to system, library, and data directories
    location ~* ^/(configurations|libraries|classes|components|themes|system|installation)/.*$ {
        deny all;
        return 404;
    }

    # Security: Block access to OSSN data directory if placed inside root
    # Note: It is highly recommended to place your 'ossn_data' directory OUTSIDE the web root.
    location ~* ^/ossn_data/.*$ {
        deny all;
        return 404;
    }

    # PHP-FPM Configuration
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        
        # Match your exact PHP version socket (e.g., php8.1-fpm, php8.2-fpm)
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock; 
        
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        
        # Performance timeouts
        fastcgi_read_timeout 300;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf)$ {
        expires max;
        log_not_found off;
        access_log off;
    }

    # Deny access to hidden files (.htaccess, .git, etc)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
