        client_max_body_size 100M; # Increase for large file uploads/course backups

        # Moodle Routing Engine
        location /
        {
                try_files $uri $uri/ /r.php;
        }

        # Pass PHP scripts to FastCGI (PHP-FPM)
        location ~ \.php(/|$)
        {
                include fastcgi_params;
                fastcgi_split_path_info ^(.+\.php)(/.+)$;
                # fastcgi_pass unix:/run/php/php8.3-fpm.sock; # Adjust to your PHP version socket
                fastcgi_pass php;
                fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
                fastcgi_param PATH_INFO $fastcgi_path_info;
                fastcgi_index index.php;
                fastcgi_read_timeout 300;
        }

        # Internal X-Accel-Redirect mapping for secure file serving via dataroot
        location /dataroot/
        {
                internal;
                alias /var/www/html/moodle/moodledata/;
        }

        # Static assets caching
        location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg|eot|mp4|webm)$
        {
                expires max;
                log_not_found off;
        }

        # Deny access to hidden files
        location ~ /\.
        {
                deny all;
        }
}
