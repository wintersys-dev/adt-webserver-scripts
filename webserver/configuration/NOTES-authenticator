Part 2: Webserver Templates (Nginx / Apache / Lighttpd + PHP-FPM)

Each template routes your PHP authenticator app cleanly while serving the 10-minute staged .html / .conf files directly from RAM (/dev/shm/wg-staged/) with no-store headers and zero directory indexing.

A. webserver/nginx.conf.DEFAULT

nginx
server {
    listen 80;
    listen [::]:80;
    #XXXXHTTPSXXXXlisten 443 ssl http2;
    #XXXXHTTPSXXXXlisten [::]:443 ssl http2;

    server_name XXXXAUTHURLXXXX;
    root /var/www/authenticator;
    index index.php;
    server_tokens off;

    #XXXXHTTPSXXXXssl_certificate /etc/letsencrypt/live/XXXXAUTHURLXXXX/fullchain.pem;
    #XXXXHTTPSXXXXssl_certificate_key /etc/letsencrypt/live/XXXXAUTHURLXXXX/privkey.pem;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;

    # Serve 10-minute staged access files directly from RAM (/dev/shm)
    location /wg/ {
        alias /dev/shm/wg-staged/;
        autoindex off;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        #XXXXFASTCGIPORTXXXXfastcgi_pass 127.0.0.1:XXXXPORTXXXX;
        #XXXXFASTCGISOCKETXXXXfastcgi_pass unix:/var/run/phpXXXXPHPVERSIONXXXX-fpm.sock;
    }

    location ~ /\.(?!well-known) { deny all; }
}
